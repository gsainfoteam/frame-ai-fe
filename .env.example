# 브라우저가 호출하는 Letsur API 베이스 URL
# 로컬 개발: Vite가 /api 를 https://gw.letsur.ai/v1 로 프록시합니다.
VITE_LETSUR_API_BASE=/api

# Cloudflare Pages 등에서 게이트웨이를 직접 호출하려면:
# VITE_LETSUR_API_BASE=https://gw.letsur.ai/v1

# OpenRouter API 베이스 URL (선택). 지정하지 않으면 https://openrouter.ai/api/v1 을 직접 호출합니다.
# VITE_OPENROUTER_API_BASE=https://openrouter.ai/api/v1
